///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
}

///|
async fn main {
  let clean = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/clean/media-pack.json",
    "examples/clean/assets", "--output", "_build/cli-smoke/clean",
  ]).output()
  if clean.exit_code() != 0 {
    raise Failure::Failure(
      "clean sample should return 0, got \{clean.exit_code()}\n\{clean.stderr()}",
    )
  }
  if !@fs.exists("_build/cli-smoke/clean/report.json") ||
    !@fs.exists("_build/cli-smoke/clean/report.html") {
    raise Failure::Failure("clean sample did not create both reports")
  }
  let clean_json = @fs.read_file("_build/cli-smoke/clean/report.json").text()
  let clean_html = @fs.read_file("_build/cli-smoke/clean/report.html").text()
  if !clean_json.contains("\"passed\": 3") ||
    !clean_json.contains("\"failed\": 0") ||
    !clean_json.contains(
      "\"sha256\": \"d361eb5db86e8dd44c63d108e6505c7c235208b36936e90762a0701d4df4d139\"",
    ) ||
    !clean_json.contains("social/cover.jpeg") ||
    !clean_json.contains("motion/preview.gif") ||
    !clean_json.contains("1200 × 630") ||
    !clean_html.contains("片盒点检") {
    raise Failure::Failure(
      "clean report should include expected assets and the independently verified SHA-256",
    )
  }
  if !clean_html.contains("SHA-256") ||
    !clean_html.contains(
      "d361eb5db86e8dd44c63d108e6505c7c235208b36936e90762a0701d4df4d139",
    ) {
    raise Failure::Failure("HTML report should expose the SHA-256 fingerprint")
  }

  let corrupt_png_dir = "_build/cli-smoke/png-crc"
  if !@fs.exists("\{corrupt_png_dir}/assets") {
    @fs.mkdir("\{corrupt_png_dir}/assets", recursive=true)
  }
  @fs.write_file(
    "\{corrupt_png_dir}/assets/corrupt.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x04\x00\x00\x00\x03\x08\x06\x00\x00\x00\xB4\xF4\xAE\xC7",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/invalid-fields.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x04\x00\x00\x00\x03\x07\x06\x00\x00\x00\x36\xA4\x39\x17",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/header-only.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x04\x00\x00\x00\x03\x08\x06\x00\x00\x00\xB4\xF4\xAE\xC6",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/bad-idat-crc.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x04\x00\x00\x00\x03\x08\x06\x00\x00\x00\xB4\xF4\xAE\xC6\x00\x00\x00\x12IDAT\x78\x9C\x63\x50\x8E\x9E\xF6\x1F\x19\x33\x10\x14\x00\x00\x6A\x2D\x18\xE5\x90\xC0\xD8\xA4\x00\x00\x00\x00IEND\xAE\x42\x60\x82",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/chunk-length-overrun.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x04\x00\x00\x00\x03\x08\x06\x00\x00\x00\xB4\xF4\xAE\xC6\x7F\xFF\xFF\xFFIDAT",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/missing-iend.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x0DIDAT\x78\x9C\x63\x60\x60\x60\x60\x00\x00\x00\x05\x00\x01\xA5\xF6\x45\x40",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/trailing-data.png",
    b"\x89PNG\r\n\x1A\n\x00\x00\x00\x0DIHDR\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x0DIDAT\x78\x9C\x63\x60\x60\x60\x60\x00\x00\x00\x05\x00\x01\xA5\xF6\x45\x40\x00\x00\x00\x00IEND\xAE\x42\x60\x82\x00",
  )
  @fs.write_file(
    "\{corrupt_png_dir}/assets/large-corrupt.png",
    Bytes::make(70_000, b'A'),
  )
  @fs.write_file(
    "\{corrupt_png_dir}/media-pack.json",
    "{\"assets\":[{\"file\":\"corrupt.png\",\"width\":4,\"height\":3,\"max_bytes\":1},{\"file\":\"invalid-fields.png\",\"width\":4,\"height\":3,\"max_bytes\":100},{\"file\":\"header-only.png\",\"width\":4,\"height\":3,\"max_bytes\":100},{\"file\":\"bad-idat-crc.png\",\"width\":4,\"height\":3,\"max_bytes\":100},{\"file\":\"chunk-length-overrun.png\",\"width\":4,\"height\":3,\"max_bytes\":100},{\"file\":\"missing-iend.png\",\"width\":1,\"height\":1,\"max_bytes\":100},{\"file\":\"trailing-data.png\",\"width\":1,\"height\":1,\"max_bytes\":100},{\"file\":\"large-corrupt.png\",\"width\":1,\"height\":1,\"max_bytes\":100000}]}",
  )
  let corrupt_png = @shell.Cmd("moon", [
    "run",
    "--target",
    "native",
    "cmd/main",
    "--",
    "\{corrupt_png_dir}/media-pack.json",
    "\{corrupt_png_dir}/assets",
    "--output",
    "\{corrupt_png_dir}/report",
  ]).output()
  if corrupt_png.exit_code() != 1 {
    raise Failure::Failure(
      "invalid PNG IHDR data should return 1, got {corrupt_png.exit_code()}",
    )
  }
  let corrupt_png_json = @fs.read_file("\{corrupt_png_dir}/report/report.json").text()
  if !corrupt_png_json.contains("\"failed\": 8") ||
    !corrupt_png_json.contains("\"sha256\": \"—\"") ||
    !corrupt_png_json.contains(
      "PNG 结构无效、不完整或 CRC 校验失败",
    ) ||
    !corrupt_png_json.contains("corrupt.png") ||
    !corrupt_png_json.contains("invalid-fields.png") ||
    !corrupt_png_json.contains("header-only.png") ||
    !corrupt_png_json.contains("bad-idat-crc.png") ||
    !corrupt_png_json.contains("chunk-length-overrun.png") ||
    !corrupt_png_json.contains("missing-iend.png") ||
    !corrupt_png_json.contains("trailing-data.png") ||
    !corrupt_png_json.contains("large-corrupt.png") ||
    !corrupt_png_json.contains(
      "b80935d45c7fcb544ad1b841005e50e452239aef65d3e0b6c07976a50f356c69",
    ) {
    raise Failure::Failure(
      "invalid PNG boundaries and a multi-block SHA-256 should be reported",
    )
  }

  let findings = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/demo/media-pack.json",
    "examples/demo/assets", "--output", "_build/cli-smoke/findings",
  ]).output()
  if findings.exit_code() != 1 {
    raise Failure::Failure(
      "sample with missing and extra images should return 1, got \{findings.exit_code()}\n\{findings.stdout()}\n\{findings.stderr()}",
    )
  }
  if !@fs.exists("_build/cli-smoke/findings/report.json") ||
    !@fs.exists("_build/cli-smoke/findings/report.html") {
    raise Failure::Failure("finding sample did not preserve both reports")
  }
  let findings_json = @fs.read_file("_build/cli-smoke/findings/report.json").text()
  if !findings_json.contains("\"failed\": 4") ||
    !findings_json.contains("exports/cover.JPG") ||
    !findings_json.contains("exports/preview.GIF") {
    raise Failure::Failure(
      "finding sample should report the missing image and three extra image paths",
    )
  }

  let case_mismatch = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/case-mismatch/media-pack.json",
    "examples/case-mismatch/assets", "--output", "_build/cli-smoke/case-mismatch",
  ]).output()
  if case_mismatch.exit_code() != 1 {
    raise Failure::Failure(
      "a case-mismatched file should return 1, got \{case_mismatch.exit_code()}",
    )
  }
  let case_mismatch_json = @fs.read_file(
    "_build/cli-smoke/case-mismatch/report.json",
  ).text()
  if !case_mismatch_json.contains("\"passed\": 0") ||
    !case_mismatch_json.contains("\"failed\": 2") {
    raise Failure::Failure(
      "case mismatch should be reported as a missing required file and an extra file",
    )
  }

  let invalid_manifest = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/invalid/media-pack.json",
    "examples/clean/assets", "--output", "_build/cli-smoke/invalid",
  ]).output()
  if invalid_manifest.exit_code() != 1 {
    raise Failure::Failure(
      "invalid manifest should return 1, got \{invalid_manifest.exit_code()}",
    )
  }

  let traversal_manifest = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/invalid/traversal.json",
    "examples/clean/assets", "--output", "_build/cli-smoke/traversal",
  ]).output()
  if traversal_manifest.exit_code() != 1 {
    raise Failure::Failure(
      "parent-directory traversal should return 1, got \{traversal_manifest.exit_code()}",
    )
  }
  let traversal_json = @fs.read_file("_build/cli-smoke/traversal/report.json").text()
  if !traversal_json.contains("..") ||
    !traversal_json.contains("安全相对路径") {
    raise Failure::Failure(
      "parent-directory traversal should be rejected with a path safety error",
    )
  }

  let missing_manifest = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/clean/missing.json",
    "examples/clean/assets", "--output", "_build/cli-smoke/missing",
  ]).output()
  if missing_manifest.exit_code() != 1 {
    raise Failure::Failure(
      "missing manifest should return 1, got \{missing_manifest.exit_code()}",
    )
  }

  let manifest_directory = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/clean/assets", "examples/clean/assets",
    "--output", "_build/cli-smoke/manifest-directory",
  ]).output()
  let manifest_directory_output = manifest_directory.stdout() +
    manifest_directory.stderr()
  if manifest_directory.exit_code() != 1 ||
    !manifest_directory_output.contains(
      "素材清单路径必须是普通文件",
    ) {
    raise Failure::Failure(
      "directory used as a manifest should get a clear error",
    )
  }

  let assets_file = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/clean/media-pack.json",
    "README.md", "--output", "_build/cli-smoke/assets-file",
  ]).output()
  let assets_file_output = assets_file.stdout() + assets_file.stderr()
  if assets_file.exit_code() != 1 ||
    !assets_file_output.contains("素材目录路径必须是目录") {
    raise Failure::Failure(
      "file used as an assets directory should get a clear error",
    )
  }

  @fs.write_file("_build/cli-smoke/output-file", "occupied")
  let output_file = @shell.Cmd("moon", [
    "run", "--target", "native", "cmd/main", "--", "examples/clean/media-pack.json",
    "examples/clean/assets", "--output", "_build/cli-smoke/output-file",
  ]).output()
  if output_file.exit_code() != 1 {
    raise Failure::Failure(
      "an output path occupied by a file should return 1, got \{output_file.exit_code()}",
    )
  }

  println(
    "CLI smoke passed: clean=0, invalid/corrupt PNG boundaries=1, findings=1, case mismatch=1, invalid/missing/traversal/wrong-kind input=1, output path conflict=1",
  )
}
